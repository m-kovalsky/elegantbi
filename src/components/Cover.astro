---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt?: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  class?: string;
}

const { src, alt = '', widths, sizes, eager = false, class: className } = Astro.props;
// Many original covers are small; never request widths beyond the source so nothing is upscaled.
const usable = widths.filter((w) => w <= src.width);
const fgWidths = usable.length ? usable : [src.width];
---

<div class:list={['cover', className]} style={`--natural-w:${src.width}px`}>
  <Image src={src} alt="" width={64} class="cover-bg" loading={eager ? 'eager' : 'lazy'} aria-hidden="true" />
  <Image
    src={src}
    alt={alt}
    widths={fgWidths}
    sizes={sizes}
    class="cover-fg"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .cover {
    position: relative;
    display: grid;
    grid-template: 100% / 100%;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--surface-2);
  }

  .cover :global(.cover-bg) {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(26px) saturate(1.35) brightness(0.6);
    transform: scale(1.35);
  }

  :global(:root[data-theme='light']) .cover :global(.cover-bg) {
    filter: blur(26px) saturate(1.2) brightness(1.08) opacity(0.75);
  }

  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(120% 90% at 50% 0%, transparent 40%, rgb(0 0 0 / 0.35));
  }

  :global(:root[data-theme='light']) .cover::after {
    background: radial-gradient(120% 90% at 50% 0%, transparent 50%, rgb(255 255 255 / 0.25));
  }

  .cover :global(.cover-fg) {
    width: auto;
    height: auto;
    max-width: min(86%, var(--natural-w));
    max-height: 80%;
    object-fit: contain;
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 18px 40px -12px rgb(0 0 0 / 0.55);
    transition: transform 0.6s var(--ease);
  }
</style>

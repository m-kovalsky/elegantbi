---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <Logo size={28} />
        <span>Elegant<span class="bi">BI</span></span>
      </a>
      <p>Techniques for creating elegant, performant and scalable data models for Power BI and Analysis Services.</p>
      <div class="socials">
        <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" size={17} /></a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" size={18} /></a>
        <a href={`mailto:${SITE.email}`} aria-label="Email"><Icon name="mail" size={18} /></a>
        <a href="/blog-feed.xml" aria-label="RSS feed"><Icon name="rss" size={18} /></a>
      </div>
    </div>
    <nav class="footer-col" aria-label="Footer">
      <h2>Explore</h2>
      <ul>
        <li><a href="/">Home</a></li>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-col">
      <h2>Subscribe</h2>
      <ul>
        <li><a href="/blog-feed.xml">RSS feed</a></li>
        <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">Follow on LinkedIn</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener noreferrer">Code on GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {year} {SITE.author}. All statements and views expressed here are solely my own.</p>
    <a href="#top" class="to-top">Back to top <Icon name="arrow-up" size={14} /></a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--border);
    background: linear-gradient(to bottom, var(--bg-soft), var(--bg));
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 3.5rem 2.5rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .bi {
    margin-left: 0.28em;
    color: var(--accent);
  }

  .footer-brand p {
    max-width: 40ch;
    margin: 1rem 0 1.25rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .socials a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .footer-col h2 {
    margin: 0 0 1rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .footer-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--text-muted);
    font-size: 0.95rem;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    transition: color 0.2s;
  }

  .to-top:hover {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  path === href || (href === '/blog' && (path.startsWith('/blog') || path.startsWith('/post/')));
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${SITE.title} home`}>
      <Logo size={30} />
      <span class="brand-name">Elegant<span class="brand-bi">BI</span></span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="search-trigger" data-search-open aria-label="Search articles">
        <Icon name="search" size={16} />
        <span class="search-label">Search</span>
        <kbd class="search-kbd"><span data-mod-key>Ctrl</span> K</kbd>
      </button>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle color theme">
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
      <button type="button" class="icon-btn menu-btn" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
        <Icon name="menu" class="icon-menu" />
        <Icon name="x" class="icon-close" />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul class="container">
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              <Icon name="arrow-right" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.25s, border-color 0.25s, backdrop-filter 0.25s;
  }

  .site-header[data-scrolled],
  .site-header:has(.mobile-nav:not([hidden])) {
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(14px);
    border-bottom-color: var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 700;
    font-size: 1.08rem;
    letter-spacing: -0.02em;
  }

  .brand-bi {
    margin-left: 0.28em;
    color: var(--accent);
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    position: relative;
    display: inline-flex;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 0.2s, background 0.2s;
  }

  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 38px;
    padding: 0 0.5rem 0 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-subtle);
    font: 500 0.88rem/1 var(--font-sans);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .search-trigger:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .search-label {
    min-width: 5.5rem;
    text-align: left;
  }

  .search-kbd {
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    font: 600 0.7rem/1 var(--font-sans);
    color: var(--text-subtle);
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }

  .icon-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  :global(:root[data-theme='dark']) .icon-btn :global(.icon-sun),
  :global(:root[data-theme='light']) .icon-btn :global(.icon-moon) {
    display: none;
  }

  .menu-btn,
  .menu-btn :global(.icon-close) {
    display: none;
  }

  .menu-btn[aria-expanded='true'] :global(.icon-menu) {
    display: none;
  }

  .menu-btn[aria-expanded='true'] :global(.icon-close) {
    display: block;
  }

  .mobile-nav ul {
    margin: 0;
    padding-block: 0.5rem 1.25rem;
    list-style: none;
  }

  .mobile-nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .mobile-nav a[aria-current='page'] {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .menu-btn {
      display: inline-grid;
    }

    .search-label,
    .search-kbd {
      display: none;
    }

    .search-trigger {
      width: 38px;
      padding: 0;
      justify-content: center;
    }
  }

  @media (min-width: 861px) {
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const systemTheme = matchMedia('(prefers-color-scheme: light)');
  const prefersLight = () => systemTheme.matches;

  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      // Choosing the theme that matches the device setting goes back to following the device.
      if ((next === 'light') === prefersLight()) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
  });

  systemTheme.addEventListener('change', () => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) document.documentElement.dataset.theme = prefersLight() ? 'light' : 'dark';
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menuBtn.getAttribute('aria-expanded') !== 'true';
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (mobileNav) mobileNav.hidden = !open;
  });

  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-mod-key]').forEach((el) => (el.textContent = '⌘'));
  }
</script>

---
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
// The mark renders in both header and footer; give each gradient its own id.
const id = `ebi-mark-${Math.random().toString(36).slice(2, 8)}`;
---

<!-- An "E" drawn as a model hierarchy: one spine, three branches, three nodes. -->
<svg width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true" class="logo-mark">
  <defs>
    <linearGradient id={id} x1="6" y1="4" x2="27" y2="28" gradientUnits="userSpaceOnUse">
      <stop stop-color="#2dd4bf"></stop>
      <stop offset="1" stop-color="#38a8f8"></stop>
    </linearGradient>
  </defs>
  <path d="M9 6.5V25.5M9 6.5H19M9 16H15.5M9 25.5H19" stroke={`url(#${id})`} stroke-width="3.2" stroke-linecap="round"></path>
  <g fill={`url(#${id})`}>
    <circle cx="23" cy="6.5" r="3.3"></circle>
    <circle cx="19.5" cy="16" r="3.3"></circle>
    <circle cx="23" cy="25.5" r="3.3"></circle>
  </g>
</svg>
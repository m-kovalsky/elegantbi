---
// Decorative hero illustration: a DAX "editor" window and a small result sparkline.
const values = [46, 40, 43, 33, 37, 27, 30, 19, 23, 9];
const step = 200 / (values.length - 1);
const pts = values.map((y, i) => `${(i * step).toFixed(1)},${y}`);
const line = `M${pts.join(' L')}`;
const area = `${line} L200,64 L0,64 Z`;
const last = pts.at(-1)!.split(',');
---

<div class="visual" aria-hidden="true">
  <div class="window">
    <div class="window-bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <span class="file">Revenue YoY %.dax</span>
      <span class="lang">DAX</span>
    </div>
    <pre class="code"><code><span class="ln">1</span><span class="m">Revenue YoY %</span> <span class="op">=</span>
<span class="ln">2</span><span class="kw">VAR</span> <span class="v">_cur</span> <span class="op">=</span> <span class="ms">[Revenue]</span>
<span class="ln">3</span><span class="kw">VAR</span> <span class="v">_prev</span> <span class="op">=</span>
<span class="ln">4</span>    <span class="fn">CALCULATE</span> (
<span class="ln">5</span>        <span class="ms">[Revenue]</span>,
<span class="ln">6</span>        <span class="fn">SAMEPERIODLASTYEAR</span> ( <span class="t">'Calendar'</span><span class="ms">[Date]</span> )
<span class="ln">7</span>    )
<span class="ln">8</span><span class="kw">RETURN</span>
<span class="ln">9</span>    <span class="fn">DIVIDE</span> ( <span class="v">_cur</span> <span class="op">-</span> <span class="v">_prev</span>, <span class="v">_prev</span> )</code></pre>
  </div>

  <div class="chart">
    <div class="chart-head">
      <span>Revenue YoY %</span>
      <strong>+18.4%</strong>
    </div>
    <div class="spark-wrap">
    <svg class="spark" viewBox="0 0 200 64" preserveAspectRatio="none">
      <defs>
        <linearGradient id="hv-area" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2dd4bf" stop-opacity="0.4"></stop>
          <stop offset="1" stop-color="#2dd4bf" stop-opacity="0"></stop>
        </linearGradient>
        <linearGradient id="hv-line" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#2dd4bf"></stop>
          <stop offset="1" stop-color="#38a8f8"></stop>
        </linearGradient>
      </defs>
      <path d={area} fill="url(#hv-area)"></path>
      <path d={line} class="spark-line" stroke="url(#hv-line)" fill="none" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" pathLength="1"></path>
    </svg>
    <span class="spark-dot" style={`left:${(+last[0] / 200) * 100}%;top:${(+last[1] / 64) * 100}%`}></span>
    </div>
  </div>

  <div class="badge">
    <span class="check">✓</span>
    <span>
      <strong>Best Practice Analyzer</strong>
      <small>0 rule violations</small>
    </span>
  </div>
</div>

<style>
  .visual {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
    padding: 1.5rem 0 7.25rem;
  }

  .window {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.65),
      0 0 0 1px rgb(255 255 255 / 0.02) inset;
    backdrop-filter: blur(12px);
    overflow: hidden;
    transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
  }

  .window::before {
    content: '';
    position: absolute;
    inset: -40% -20% auto auto;
    width: 70%;
    height: 80%;
    background: radial-gradient(circle, rgb(45 212 191 / 0.16), transparent 65%);
    pointer-events: none;
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.8rem 1rem;
    border-bottom: 1px solid var(--border);
    font: 500 0.75rem/1 var(--font-mono);
    color: var(--text-subtle);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface-3);
  }

  .dots i:first-child {
    background: #ff5f57;
  }

  .dots i:nth-child(2) {
    background: #febc2e;
  }

  .dots i:nth-child(3) {
    background: #28c840;
  }

  .lang {
    margin-left: auto;
    padding: 0.2rem 0.45rem;
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 700;
  }

  .code {
    margin: 0;
    padding: 1.1rem 1.2rem 1.3rem;
    overflow: hidden;
    font: 0.84rem/1.85 var(--font-mono);
    color: var(--text);
    white-space: pre;
  }

  .ln {
    display: inline-block;
    width: 1.6rem;
    color: var(--text-subtle);
    opacity: 0.55;
    user-select: none;
  }

  .m {
    color: var(--text);
    font-weight: 600;
  }

  .kw {
    color: #4d9375;
  }

  .fn {
    color: #80a665;
  }

  .ms {
    color: #6394bf;
  }

  .t {
    color: #c98a7d;
  }

  .v {
    color: #bd976a;
  }

  .op {
    color: var(--text-subtle);
  }

  :global(:root[data-theme='light']) .kw {
    color: #1e754f;
  }

  :global(:root[data-theme='light']) .fn {
    color: #59873a;
  }

  :global(:root[data-theme='light']) .ms {
    color: #296aa3;
  }

  :global(:root[data-theme='light']) .t {
    color: #b56959;
  }

  :global(:root[data-theme='light']) .v {
    color: #b07d48;
  }

  .chart {
    position: absolute;
    left: -2.5rem;
    bottom: 0;
    width: 230px;
    padding: 0.95rem 1rem 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-soft) 92%, transparent);
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(10px);
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.8rem;
    font-size: 0.72rem;
    color: var(--text-subtle);
  }

  .chart-head strong {
    color: #4ade80;
    font-size: 0.85rem;
  }

  .spark-wrap {
    position: relative;
    height: 64px;
  }

  .spark {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .spark-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.4s var(--ease) 0.2s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .spark-dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #38a8f8;
    box-shadow: 0 0 0 4px rgb(56 168 248 / 0.25);
    transform: translate(-50%, -50%);
  }

  .badge {
    position: absolute;
    right: -1rem;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 0.9rem 0.6rem 0.65rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-soft) 92%, transparent);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(10px);
    font-size: 0.75rem;
  }

  .badge strong {
    display: block;
    font-weight: 600;
  }

  .badge small {
    color: var(--text-subtle);
  }

  .check {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgb(74 222 128 / 0.15);
    color: #4ade80;
    font-weight: 700;
  }
</style>

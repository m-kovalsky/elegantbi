---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import HeroVisual from '../components/HeroVisual.astro';
import { SITE } from '../consts';
import { getCategories, getPosts } from '../utils/posts';

const posts = await getPosts();
const [featured, ...rest] = posts;
const latest = rest.slice(0, 6);
const categories = getCategories(posts);
const firstYear = posts.at(-1)?.data.pubDate.getUTCFullYear();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about` },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Power BI · Analysis Services · DAX</span>
        <h1>
          Architecting <span class="gradient-text">elegant</span>, performant &amp; scalable data models.
        </h1>
        <p class="hero-lead">{SITE.tagline}</p>
        <div class="hero-actions">
          <a href="/blog" class="btn btn-primary">Browse articles <Icon name="arrow-right" size={16} /></a>
          <button type="button" class="btn" data-search-open><Icon name="search" size={16} /> Search the archive</button>
        </div>
        <dl class="stats">
          <div><dt>Articles</dt><dd>{posts.length}</dd></div>
          <div><dt>Topics</dt><dd>{categories.length}</dd></div>
          <div><dt>Writing since</dt><dd>{firstYear}</dd></div>
        </dl>
      </div>
      <HeroVisual />
    </div>
  </section>

  {
    featured && (
      <section class="container section">
        <div class="section-head">
          <div>
            <span class="eyebrow">Latest</span>
            <h2>Featured article</h2>
          </div>
        </div>
        <PostCard post={featured} featured eager />
      </section>
    )
  }

  <section class="container section">
    <div class="section-head">
      <div>
        <span class="eyebrow">Recent</span>
        <h2>More from the blog</h2>
      </div>
      <a href="/blog" class="link-arrow">All {posts.length} articles <Icon name="arrow-right" size={16} /></a>
    </div>
    <div class="post-grid">
      {latest.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="container section">
    <div class="topics">
      <div>
        <span class="eyebrow">Explore</span>
        <h2>Browse by topic</h2>
        <p class="muted">From automation scripts for Tabular Editor to DAX patterns and Direct Lake migration.</p>
      </div>
      <ul class="topic-list">
        {
          categories.map((c) => (
            <li>
              <a href={`/blog/categories/${c.slug}`} class="topic">
                <span>{c.name}</span>
                <span class="topic-count">{c.count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="container section">
    <div class="about-strip">
      <div class="avatar" aria-hidden="true">{SITE.authorShort}</div>
      <div>
        <h2>Hi, I'm {SITE.author}.</h2>
        <p>
          I specialize in business intelligence and analytics with a focus on Analysis Services, tabular modeling and DAX.
          Having architected Microsoft's internal best-in-class data models used by 30,000+ people, this blog is where I share
          techniques for building elegant, performant and scalable models.
        </p>
        <div class="about-links">
          <a href="/about" class="link-arrow">More about me <Icon name="arrow-right" size={16} /></a>
          <a href={SITE.github} class="link-arrow" target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> GitHub</a>
          <a href={SITE.linkedin} class="link-arrow" target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={15} /> LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(2.5rem, 6vw, 4rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (max-width: 1100px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-grid > :global(.visual) {
      display: none;
    }
  }

  .hero h1 {
    max-width: 18ch;
    margin: 1.2rem 0 1.4rem;
    font-size: clamp(2.5rem, 4.7vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 750;
  }

  .hero-lead {
    max-width: 60ch;
    margin: 0 0 2rem;
    color: var(--text-muted);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin: 3.25rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    max-width: 640px;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats dt {
    color: var(--text-subtle);
    font-size: 0.85rem;
  }

  .stats dd {
    margin: 0 0 0.15rem;
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .section {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .topics {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--surface), color-mix(in srgb, var(--surface) 40%, transparent));
  }

  .topics h2 {
    margin: 0.4rem 0 0.75rem;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
  }

  .topics p {
    margin: 0;
  }

  .topic-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    align-content: start;
  }

  .topic {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-soft);
    font-weight: 550;
    font-size: 0.95rem;
    transition: border-color 0.2s, background 0.2s, transform 0.2s var(--ease);
  }

  .topic:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-1px);
  }

  .topic-count {
    min-width: 1.8rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-subtle);
    font-size: 0.78rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .about-strip {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--accent-ink);
    font-weight: 800;
    letter-spacing: -0.02em;
    font-size: 1.2rem;
  }

  .about-strip h2 {
    margin: 0.2rem 0 0.6rem;
    font-size: 1.4rem;
  }

  .about-strip p {
    max-width: 70ch;
    margin: 0 0 1.1rem;
    color: var(--text-muted);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (max-width: 860px) {
    .topics {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .about-strip {
      flex-direction: column;
    }
  }
</style>

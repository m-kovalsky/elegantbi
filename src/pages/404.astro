---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <div class="container not-found">
    <span class="code gradient-text">404</span>
    <h1>This page took a different relationship path.</h1>
    <p>The page you're looking for doesn't exist or has moved. Try searching the archive or head back to the articles.</p>
    <div class="actions">
      <a href="/blog" class="btn btn-primary">Browse articles <Icon name="arrow-right" size={16} /></a>
      <button type="button" class="btn" data-search-open><Icon name="search" size={16} /> Search</button>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    max-width: 720px;
    padding-block: clamp(5rem, 14vw, 9rem) 2rem;
    text-align: center;
  }

  .code {
    display: block;
    font-size: clamp(5rem, 16vw, 9rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  h1 {
    margin: 1.25rem 0 1rem;
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
  }

  p {
    margin: 0 auto 2rem;
    max-width: 52ch;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

{
  "name": "dax",
  "displayName": "DAX",
  "scopeName": "source.dax",
  "aliases": ["DAX"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#table-column" },
    { "include": "#table" },
    { "include": "#column" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.dax", "match": "//.*$" },
        { "name": "comment.line.double-dash.dax", "match": "--.*$" },
        { "name": "comment.block.dax", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.dax",
      "begin": "\"",
      "end": "\"(?!\")",
      "patterns": [{ "name": "constant.character.escape.dax", "match": "\"\"" }]
    },
    "table-column": {
      "match": "('(?:[^']|'')*'|[A-Za-z_][A-Za-z0-9_]*)(\\[[^\\]]*\\])",
      "captures": {
        "1": { "name": "entity.name.type.table.dax" },
        "2": { "name": "variable.other.member.column.dax" }
      }
    },
    "table": {
      "name": "entity.name.type.table.dax",
      "match": "'(?:[^']|'')*'"
    },
    "column": {
      "name": "variable.other.measure.dax",
      "match": "\\[[^\\]]*\\]"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dax",
          "match": "(?i)\\b(DEFINE|EVALUATE|ORDER\\s+BY|START\\s+AT|MEASURE|VAR|RETURN|COLUMN|TABLE|ASC|DESC|IN|NOT|AND|OR)\\b"
        },
        { "name": "constant.language.dax", "match": "(?i)\\b(TRUE|FALSE|BLANK)\\b(?!\\s*\\()" }
      ]
    },
    "functions": {
      "name": "support.function.dax",
      "match": "\\b[A-Za-z][A-Za-z0-9_.]*(?=\\s*\\()"
    },
    "numbers": {
      "name": "constant.numeric.dax",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.dax",
      "match": "&&|\\|\\||<>|<=|>=|==|[-+*/^=<>&]"
    }
  }
}
